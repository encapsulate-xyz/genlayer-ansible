# Ubuntu 24.04 with systemd and SSH, like our servers after server-setup-playbook.
# curl, python3-debian (for apt repositories), python3-requests (for the Docker modules), wget (for the nvm
# role) and zstd (for sync_node.yml) come with Ubuntu's server image, and unzip (for Alloy) with
# server-setup-playbook; this image has none of them
FROM {{ item.image }}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        iproute2 \
        iptables \
        openssh-server \
        python3 \
        python3-apt \
        python3-debian \
        python3-requests \
        sudo \
        systemd \
        systemd-sysv \
        unzip \
        wget \
        zstd

# the container runs privileged, so its systemd would otherwise reset the host's binfmt handlers
RUN systemctl mask systemd-binfmt.service proc-sys-fs-binfmt_misc.automount proc-sys-fs-binfmt_misc.mount

STOPSIGNAL SIGRTMIN+3
