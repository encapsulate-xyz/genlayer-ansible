# Ubuntu 24.04 with systemd and SSH, like our servers after server-setup-playbook.
# sync_node.yml needs curl and zstd, which come with Ubuntu's server image, and Alloy needs unzip,
# which server-setup-playbook installs; this image has none of them
FROM {{ item.image }}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        iproute2 \
        iptables \
        openssh-server \
        python3 \
        python3-apt \
        sudo \
        systemd \
        systemd-sysv \
        unzip \
        zstd

# the container runs privileged, so its systemd would otherwise reset the host's binfmt handlers
RUN systemctl mask systemd-binfmt.service proc-sys-fs-binfmt_misc.automount proc-sys-fs-binfmt_misc.mount

STOPSIGNAL SIGRTMIN+3
