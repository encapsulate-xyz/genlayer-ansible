# yaml-language-server: $schema=https://raw.githubusercontent.com/yeagerai/genvm/refs/heads/v0.3.x/doc/schemas/default-config.json#/llm

bind_address: 127.0.0.1:{{ genlayer.llm.ports.listen_port }}

lua_script_path: {{ node_genvm_dir }}/config/genvm-llm-default.lua
vm_count: 6
data_dir: {{ node_genvm_dir }}/data
lua_path: {{ node_genvm_dir }}/lib/genvm-lua/?.lua
signer_url: "http://localhost:{{ genlayer.validator.ports.admin_port }}/admin/genvm/sign"
signer_headers:
  x-admin-auth: "#{admin_token}"

threads: 4
blocking_threads: 16
log_disable: tracing*,polling*,tungstenite*,tokio_tungstenite*

# ---------------------------------------------------------------------------
# Greybox chains — worked example
#
# `meta.greybox` below is the chain definition read by genvm-llm-greybox.lua.
# It only takes effect when `lua_script_path` above points at that script;
# genvm-llm-default.lua ignores it and orders by provider `meta.priority`
# instead (note the two run in OPPOSITE directions).
#
#   * It goes on a MODEL, under a backend's `models:` — not on the backend.
#   * The value is a table keyed by chain, never a bare number: a scalar makes
#     the Lua raise at module load.
#   * `text` and `image` are independent chains. Lower number = tried first;
#     the next entry is the fallback.
#   * A model with no `meta.greybox` is simply left out of the chains. If NO
#     model anywhere declares one, the Lua errors and the node fails to start.
#
#   models:
#     deepseek/deepseek-v3.2:
#       meta:
#         greybox: { text: 1 }        # primary of the text chain
#     anthropic/claude-haiku-4.5:
#       meta:
#         greybox: { text: 3, image: 3 }   # participates in both chains
#
# Chain changes are applied by restarting the LLM module; there is no runtime
# override file. Full runbook: greybox-setup-guide.md (packaged alongside).
# ---------------------------------------------------------------------------
backends:
  openrouter:
    enabled: false
    host: https://openrouter.ai/api
    provider: openai-compatible
    key: ${ENV[OPENROUTERKEY]}
    models:
      openai/gpt-5.4-mini:
        supports_json: true
        supports_image: true
        meta:
          greybox: { image: 1 }
      anthropic/claude-haiku-4.5:
        supports_json: true
        supports_image: true
        meta:
          greybox: { text: 3, image: 3 }
      google/gemini-3-flash-preview:
        supports_json: true
        supports_image: true
        meta:
          greybox: { image: 2 }
      qwen/qwen3-235b-a22b:
        supports_json: true
        supports_image: false
        meta:
          greybox: { text: 2 }
      deepseek/deepseek-v3.2:
        supports_json: true
        supports_image: false
        meta:
          greybox: { text: 1 }
      moonshotai/kimi-k2-0905:
        supports_json: true
        supports_image: false
        meta:
          greybox: { text: 4 }
      z-ai/glm-5:
        supports_json: true
        supports_image: false
        meta:
          greybox: { text: 5 }

  heurist:
    enabled: false
    host: https://llm-gateway.heurist.xyz
    provider: openai-compatible
    key: ${ENV[HEURISTKEY]}
    models:
      meta-llama/llama-3.3-70b-instruct:
        supports_json: true
        supports_image: false # this model does not support images
        meta:
          greybox: { text: 6 }

  comput3:
    enabled: false
    host: https://api.comput3.ai
    provider: openai-compatible
    key: ${ENV[COMPUT3KEY]}
    models:
      llama3:70b:
        supports_json: true
        supports_image: false # this model does not support images

  ionet:
    enabled: true
    host: https://api.intelligence.io.solutions/api
    provider: openai-compatible
    key: ${ENV[IOINTELLIGENCEKEY]}
    models:
      # io.net retired the older models, these come from its "Available models" list (Oct 2026)
      deepseek-ai/DeepSeek-V4.1-Flash:
        supports_json: true
        supports_image: false
      zai-org/GLM-5.3:
        supports_json: true
        supports_image: false
      zai-org/GLM-5.3-Flash:
        supports_json: true
        supports_image: false
      XiaomiMiMo/MiMo-V2.6-Flash:
        supports_json: true
        supports_image: false

  libertai:
    enabled: false
    host: https://api.libertai.io
    provider: openai-compatible
    key: ${ENV[LIBERTAI_API_KEY]}
    models:
      hermes-3-8b-tee:
        supports_json: true
        supports_image: false
      gemma-3-27b:
        supports_json: true
        supports_image: false

  morpheus:
    enabled: false
    host: https://api.mor.org/api
    provider: openai-compatible
    key: ${ENV[MORPHEUS_API_KEY]}
    models:
      glm-5:
        supports_json: true
        supports_image: false
      kimi-k2.5:
        supports_json: true
        supports_image: false
      hermes-3-llama-3.1-405b:
        supports_json: true
        supports_image: false
      qwen3-235b:
        supports_json: true
        supports_image: false
      qwen3-coder-480b-a35b-instruct:
        supports_json: true
        supports_image: false
      llama-3.3-70b:
        supports_json: true
        supports_image: false
      glm-4.7:
        supports_json: true
        supports_image: false
      mistral-31-24b:
        supports_json: true
        supports_image: false

  openai:
    enabled: false
    host: https://api.openai.com
    provider: openai-compatible
    key: ${ENV[OPENAIKEY]}
    models:
      gpt-4o:
        supports_json: true
        supports_image: true # works
        meta: {} # <- you can put anything here to read it from lua

  anthropic:
    enabled: false
    host: https://api.anthropic.com
    provider: anthropic
    key: ${ENV[ANTHROPICKEY]}
    models:
      claude-3-7-sonnet-20250219:
        supports_json: false # it is quite bad because it wraps result into random "result/value/object/..."
        supports_image: true # works

  xai:
    enabled: false
    host: https://api.x.ai
    provider: openai-compatible
    key: ${ENV[XAIKEY]}
